# ─────────────────────────────────────────────────────────────
# Freight AI Ops — environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────
APP_ENV=local
LOG_LEVEL=INFO
# Secret used to sign auth tokens. Generate a long random string for production.
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Default single-user credentials (bootstrap account, created on first run).
ADMIN_EMAIL=operator@example.com
ADMIN_PASSWORD=change-me

# ── Database (PostgreSQL) ────────────────────────────────────
POSTGRES_USER=freight
POSTGRES_PASSWORD=freight
POSTGRES_DB=freight_ai_ops
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Full URL is derived from the parts above by the backend; override if needed.
# DATABASE_URL=postgresql+psycopg://freight:freight@postgres:5432/freight_ai_ops

# ── Redis / Celery ───────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── LLM provider ─────────────────────────────────────────────
# Which provider the AI agents use by default: anthropic | openai | gemini
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-4-8

# Provide the key for whichever provider(s) you use. Keys stay in .env only.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ── Frontend ─────────────────────────────────────────────────
# Base URL the browser uses to reach the backend API.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ── Company defaults (used in generated documents) ───────────
COMPANY_NAME=Your Freight Company
USER_FULL_NAME=Operations Coordinator
EMAIL_SIGNATURE=Best regards,
DEFAULT_MARKUP_PERCENT=20
DEFAULT_CURRENCY=USD
